# ==============================================================================
# COMMUNITY 360 - Configuración de Variables de Entorno (.env.example)
# Copia este archivo a .env y completa los valores con tus credenciales reales.
# NUNCA subas el archivo .env real ni compartas tus contraseñas o secretos.
# ==============================================================================

# ─── Servidor Web ──────────────────────────────────────────────────────────────
# Puerto donde escuchará Express + Socket.IO (Render asigna PORT automáticamente)
PORT=3000

# Entorno de ejecución: 'development' (local) o 'production' (Render / HTTPS)
NODE_ENV=development

# Orígenes permitidos para CORS/Socket.IO en producción (opcional, separados por coma)
# Ejemplo: https://community360.onrender.com
CORS_ORIGIN=

# ─── TiDB Cloud (Base de Datos Relacional - SQL) ───────────────────────────────
# Host del clúster TiDB Cloud Serverless
TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com

# Puerto TLS de TiDB Cloud (por defecto 4000)
TIDB_PORT=4000

# Usuario de conexión SQL (incluye el prefijo del clúster)
TIDB_USER=tu_prefijo_cluster.root

# Contraseña del usuario de TiDB Cloud
TIDB_PASSWORD=tu_password_tidb

# Nombre de la base de datos aprobada en Fase 1 y 2
TIDB_DATABASE=community360

# Ruta al certificado CA para verificación TLS obligatoria
TIDB_CA_CERT=./tidb-ca.pem

# ─── Couchbase Capella (Base de Datos Documental - NoSQL) ──────────────────────
# Cadena de conexión TLS obligatoria (debe iniciar con couchbases://)
CB_CONNECTION_STRING=couchbases://cb.xxxx.cloud.couchbase.com

# Usuario de acceso al bucket de Capella
CB_USERNAME=tu_usuario_capella

# Contraseña del usuario de Capella
CB_PASSWORD=tu_password_capella

# Nombre del bucket, scope y colección en Capella
CB_BUCKET=community360
CB_SCOPE=_default
CB_COLLECTION=interacciones

# ─── Sesiones y Seguridad ──────────────────────────────────────────────────────
# Clave criptográfica para firmar cookies de sesión (OBLIGATORIO en producción;
# genera una cadena aleatoria de al menos 32 bytes hexadecimales).
SESSION_SECRET=cambia_esta_clave_por_una_cadena_aleatoria_segura_de_64_caracteres

# Duración de la sesión en milisegundos (86400000 = 24 horas)
SESSION_LIFETIME_MS=86400000
